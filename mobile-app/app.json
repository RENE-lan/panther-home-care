{
  "expo": {
    "name": "Panther Home Care",
    "slug": "panther-home-care",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "panther",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f1e38"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cd.panther.homecare"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f1e38"
      },
      "package": "cd.panther.homecare"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "newArchEnabled": false
  }
}