# ────────────────────────────────────────────────────────────────
#  Panther Home Care — configuration locale
#  Copiez ce fichier en ".env" (même dossier que manage.py) et
#  renseignez votre clé Anthropic pour que l'IA réponde à TOUT.
# ────────────────────────────────────────────────────────────────

# Clé API Claude (Anthropic) — https://console.anthropic.com/  →  API Keys
AI_API_KEY=sk-ant-VOTRE_CLE_ICI

# Fournisseur et modèle (déjà réglés sur Claude par défaut)
AI_PROVIDER=anthropic
AI_MODEL=claude-3-5-sonnet-latest
