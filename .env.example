# Copy to .env and adjust. All are optional for local SQLite dev.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=*

# PostgreSQL (leave unset to use SQLite locally). Either set POSTGRES_* ...
# POSTGRES_DB=panther
# POSTGRES_USER=panther
# POSTGRES_PASSWORD=secret
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# ... or a single URL (requires dj-database-url):
# DATABASE_URL=postgres://panther:secret@localhost:5432/panther

# --- Social sign-in (OAuth). Email/password works without any of these. ---
# Each provider's button goes live once you supply its credentials, then restart.
# Google:   https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Facebook: https://developers.facebook.com/apps
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# Apple:    https://developer.apple.com/account/resources/identifiers
# APPLE_CLIENT_ID=
# APPLE_KEY_ID=
# APPLE_SECRET=
# APPLE_PRIVATE_KEY=

# ============================================================================
#  AI provider (optional) — powers the LLM daily brief. Without it, the app
#  uses its built-in rule-based AI, so everything still works.
#
#  This key stays on the SERVER. Never put it in the frontend or in code.
#  1) Choose a provider,  2) paste your key,  3) restart the server.
# ============================================================================
AI_PROVIDER=openai          # openai | anthropic | gemini
AI_API_KEY=                 # <-- PASTE YOUR API KEY HERE
# AI_MODEL=                 # optional override; sensible default per provider:
                            #   openai    -> gpt-4o-mini
                            #   anthropic -> claude-3-5-haiku-latest
                            #   gemini    -> gemini-1.5-flash
